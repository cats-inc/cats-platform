<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's V8 JIT. Without these two the renderer aborts on launch
         under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The sidecars load native addons out of Resources/app-sidecar and
         Resources/cats-runtime (sharp, fsevents, playwright-core), which the
         hardened runtime refuses to map without this. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice input in the chat composer. NSMicrophoneUsageDescription alone
         is not enough once the hardened runtime is on: both the renderer
         helper and Resources/native/macos-stt/cats-stt-macos need the
         entitlement to reach the input device. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
